# Copy to deploy/.env and adjust. docker compose reads it from the deploy/ directory.

# Where everything is kept on this machine; an absolute path. Holds postgres/ (the database),
# platform/ (run logs, secrets.env) and tradingagents/ (reports, price cache, memory log, shared
# with the analysis containers). Stopping, restarting or recreating containers keeps it.
PLATFORM_DATA=/srv/trading-analysis-platform

# Database password (the database is only reachable from the platform container).
POSTGRES_PASSWORD=change-me

# Port on 127.0.0.1 where the UI and API are served.
PLATFORM_PORT=8080

# The first admin, created on the first start only (later starts ignore both). Leave the password
# empty to get a generated one, printed once in the log:
#   docker compose -f deploy/docker-compose.yml logs platform
# A generated password must be changed after the first login.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=
# A configured password must meet the password policy (not a common password, not the username, at
# most 128 characters), or the platform does not start. The minimum length defaults to 12; the
# range is 8 to 64.
# PLATFORM_PASSWORD_MIN_LENGTH=12

# The Docker (or Podman) socket on this machine, handed to docker-socket-proxy only.
# Docker: /var/run/docker.sock · rootless Podman: /run/user/<uid>/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock

# Images, as built by `mise run docker-build`: tagged latest and with the platform version
# (scripts/version.sh), e.g. ta-runner:0.1.0 to stay on one release.
PLATFORM_IMAGE=trading-analysis-platform:latest
TA_RUNNER_IMAGE=ta-runner:latest

# Public HTTPS (deploy/docker-compose.public.yml): a Caddy container in front of the platform gets
# and renews a Let's Encrypt certificate for the domain, redirects http:// and www. to
# https://<domain>, and answers 404 on /actuator/* but /actuator/health. Both are required by the
# overlay and unused without it. The domain's DNS (an A record, and a CNAME for www) must point at
# this machine, and ports 80/tcp, 443/tcp and 443/udp must be open, before the first start:
#   docker compose -f docker-compose.yml -f docker-compose.public.yml up -d
# PLATFORM_DOMAIN=example.com
# ACME_EMAIL=you@example.com

# Provider API keys are entered on the Settings page; they are kept in
# ${PLATFORM_DATA}/platform/secrets.env (owner-only) and handed to each analysis container.
