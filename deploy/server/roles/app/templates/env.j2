# Written by Ansible (deploy/server/roles/app); the next deploy overwrites changes.
PLATFORM_DATA={{ platform_data }}
POSTGRES_PASSWORD={{ app_postgres_password }}
PLATFORM_PORT={{ platform_port }}
PLATFORM_ADMIN_USERNAME={{ platform_admin_username }}
DOCKER_SOCKET=/var/run/docker.sock
PLATFORM_IMAGE={{ app_platform_image }}
TA_RUNNER_IMAGE={{ app_runner_image }}
{% if public_domain | length > 0 %}
PLATFORM_DOMAIN={{ public_domain }}
ACME_EMAIL={{ acme_email }}
COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
{% endif %}
