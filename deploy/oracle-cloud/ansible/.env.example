# Nothing reads this file: copy it to .env, edit it and `source .env` before `mise run oracle:deploy`,
# or export the variable from any secret manager. .env is gitignored.
#
# A Tailscale auth key, from https://login.tailscale.com/admin/settings/keys (pre-approved if your
# tailnet approves devices). The first deploy needs it to log the VM in; later deploys do not.
# A one-off key is enough.
# The key starts with "tskey-auth-"; paste the whole key after the equals sign.
TAILSCALE_AUTHKEY=
