// Renovate (the hosted GitHub app) keeps every pinned dependency current: one pull request with
// every update once a week, plus lock file maintenance. See README, "Continuous integration".
// Renovate reads this file from main; it lists everything it tracks in its dependency dashboard issue.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Enables the dependency dashboard issue and the managers in use: gradle (the version catalog),
  // gradle-wrapper, npm (pnpm: artifact/frontend/ and e2e/), pep621 with uv (artifact/ta-runner/),
  // dockerfile, docker-compose, github-actions and mise (mise.toml).
  extends: ["config:recommended"],

  // One batch a week, not a stream of pull requests; the Monday morning's review picks it up.
  schedule: ["before 6am on monday"],
  timezone: "Europe/Berlin",

  // The ruleset needs an admin to merge, and a dependency update is reviewed like any change.
  // (The default, set so nobody turns it on by accident.)
  automerge: false,

  // The release notes list these under "Build, CI and dependencies" (.github/release.yml).
  labels: ["dependencies"],

  // Every update in one pull request (below), majors included: one review, one CI run, one merge
  // and no version clashes between update pull requests. A major gets no pull request of its own.
  separateMajorMinor: false,

  // pnpm-lock.yaml and uv.lock, refreshed within their ranges, on the same schedule.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },

  // config:recommended skips test directories (:ignoreModulesAndTests), but the TradingAgents
  // version is also pinned in ta-runner's contract test (below). ignorePaths lists the preset's
  // other paths.
  ignorePresets: [":ignoreModulesAndTests"],
  ignorePaths: ["**/node_modules/**", "**/bower_components/**", "**/vendor/**", "**/examples/**", "**/__fixtures__/**"],

  customManagers: [
    {
      // node and pnpm in the version catalog are read by node-gradle, not by Gradle's dependency
      // resolution, so the gradle manager does not see them.
      customType: "regex",
      managerFilePatterns: ["gradle/libs.versions.toml"],
      matchStrings: ['(?:^|\\n)node = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "node",
      datasourceTemplate: "node-version",
    },
    {
      customType: "regex",
      managerFilePatterns: ["gradle/libs.versions.toml"],
      matchStrings: ['(?:^|\\n)pnpm = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "pnpm",
      datasourceTemplate: "npm",
    },
    {
      // jacoco and palantirJavaFormat are only read from Kotlin DSL (libs.versions.<name>.get()),
      // never through a [libraries] or [plugins] version.ref, so the gradle manager does not see them.
      customType: "regex",
      managerFilePatterns: ["gradle/libs.versions.toml"],
      matchStrings: ['(?:^|\\n)jacoco = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "org.jacoco:org.jacoco.agent",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      managerFilePatterns: ["gradle/libs.versions.toml"],
      matchStrings: ['(?:^|\\n)palantirJavaFormat = "(?<currentValue>[^"]+)"'],
      depNameTemplate: "com.palantir.javaformat:palantir-java-format",
      datasourceTemplate: "maven",
    },
    {
      // TradingAgents is a release archive URL in pyproject.toml (no manager reads that) and its
      // version is pinned again in the contract test: both change in one pull request.
      customType: "regex",
      managerFilePatterns: [
        "artifact/ta-runner/pyproject.toml",
        "artifact/ta-runner/tests/engine/test_upstream_contract.py",
      ],
      matchStrings: [
        "TauricResearch/TradingAgents/archive/refs/tags/v(?<currentValue>[^\"/]+)\\.tar\\.gz",
        'compat\\.upstream_version\\(\\) == "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "TauricResearch/TradingAgents",
      datasourceTemplate: "github-tags",
      // The tags are v0.5.1; the files hold 0.5.1 (or the tag in the URL, whose "v" is in the regex).
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],

  // Later rules override earlier ones: the one group first, then the limits.
  packageRules: [
    {
      description: "All dependencies: one pull request a week",
      matchPackageNames: ["*"],
      groupName: "all dependencies",
      groupSlug: "all",
    },
    {
      // pnpm (12) refuses to install a package version younger than a day (its default
      // minimumReleaseAge), in CI too: Renovate waits as long, or the update fails CI.
      description: "npm packages: at least a day old, as pnpm requires",
      matchDatasources: ["npm"],
      minimumReleaseAge: "1 day",
    },
    {
      // A new TradingAgents needs code changes, so the pull request fails CI until they are made.
      description: "TradingAgents",
      matchDepNames: ["TauricResearch/TradingAgents"],
      prBodyNotes: [
        "**TradingAgents is in this update:** run `uv lock` in `artifact/ta-runner/` and commit `uv.lock`, and adapt `ta_runner/engine/compat.py` and the contract tests to the new release. CI fails until then.",
      ],
    },
    {
      // The package.json engines field is a lower bound ("node >=24"), not a pin.
      description: "Do not rewrite the engines field",
      matchManagers: ["npm"],
      matchDepTypes: ["engines"],
      enabled: false,
    },
    {
      // Odd majors are short-lived releases without long-term support.
      description: "Node.js: even (LTS) majors only",
      matchManagers: ["custom.regex"],
      matchDepNames: ["node"],
      allowedVersions: "/^\\d*[02468]\\./",
    },
    {
      // Java 25 is the LTS the build targets; Python 3.12 is ta-runner's requires-python.
      description: "Base images stay on Java 25",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["eclipse-temurin"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Python stays on 3.12 (image, .python-version, requires-python)",
      matchManagers: ["dockerfile", "pyenv", "pep621"],
      matchPackageNames: ["python"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      // A major PostgreSQL version needs a data migration. When #10 adds Testcontainers, its
      // postgres:18.x reference follows this rule too.
      description: "PostgreSQL: no major updates",
      matchManagers: ["docker-compose"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Same reason as the eclipse-temurin image: the build targets Java 25.
      description: "Java stays on 25",
      matchManagers: ["mise"],
      matchPackageNames: ["java"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
